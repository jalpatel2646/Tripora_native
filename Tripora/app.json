{
  "expo": {
    "name": "Tripora",
    "slug": "Tripora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "tripora",
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Tripora to access your camera.",
          "microphonePermission": "Allow Tripora to access your microphone."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Tripora to save videos to your photos.",
          "savePhotosPermission": "Allow Tripora to save videos to your photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Tripora to use your location."
        }
      ],
      "expo-secure-store"
    ]
  }
}
